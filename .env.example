# Neon Postgres (pgvector) — Settings → Connection string in the Neon dashboard
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Clerk — API keys from the Clerk dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk redirect URLs (match the app's route structure)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Model providers
GROQ_API_KEY=gsk_...
HUGGINGFACE_API_TOKEN=hf_...

# Playwright e2e — credentials of a test user that exists in your Clerk instance
E2E_CLERK_USER_IDENTIFIER=playwright@example.com
E2E_CLERK_USER_PASSWORD=

# Optional overrides
# LLM_MODEL=llama-3.1-8b-instant
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
